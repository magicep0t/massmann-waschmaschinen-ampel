#include <IPAddress.h>
#include <Arduino.h>

namespace Ampel_data_config {
    // WiFi configuration
    const char conf_ssid[] = "DEIN_WIFI_SSID";
    const char conf_password[] = "DEIN_WIFI_PASSWORT";

    // Optional Static IP Configuration
    // Set conf_use_static_ip to false to use DHCP
